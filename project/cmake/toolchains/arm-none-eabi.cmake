set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

get_filename_component(BOARDMANAGER_TOOLCHAINS_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../toolchains" ABSOLUTE)
set(DEDICATED_ARM_GNU_TOOLCHAIN_ROOT "${BOARDMANAGER_TOOLCHAINS_ROOT}/arm-gnu-toolchain")
set(FALLBACK_ARM_GNU_TOOLCHAIN_ROOT "${BOARDMANAGER_TOOLCHAINS_ROOT}")

if(EXISTS "${DEDICATED_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc.exe")
    set(ARM_GNU_TOOLCHAIN_ROOT "${DEDICATED_ARM_GNU_TOOLCHAIN_ROOT}")
elseif(EXISTS "${FALLBACK_ARM_GNU_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc.exe")
    set(ARM_GNU_TOOLCHAIN_ROOT "${FALLBACK_ARM_GNU_TOOLCHAIN_ROOT}")
elseif(DEFINED ENV{ARM_GNU_TOOLCHAIN_ROOT})
    set(ARM_GNU_TOOLCHAIN_ROOT "$ENV{ARM_GNU_TOOLCHAIN_ROOT}")
else()
    message(FATAL_ERROR "ARM_GNU_TOOLCHAIN_ROOT was not provided and no local Arm GNU toolchain was found under project/toolchains")
endif()

file(TO_CMAKE_PATH "${ARM_GNU_TOOLCHAIN_ROOT}" ARM_GNU_TOOLCHAIN_ROOT_CMAKE)
set(TOOLCHAIN_BIN_DIR "${ARM_GNU_TOOLCHAIN_ROOT_CMAKE}/bin")
set(TOOLCHAIN_PREFIX "${TOOLCHAIN_BIN_DIR}/arm-none-eabi")

set(CMAKE_C_COMPILER "${TOOLCHAIN_PREFIX}-gcc.exe")
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_PREFIX}-gcc.exe")
set(CMAKE_AR "${TOOLCHAIN_PREFIX}-ar.exe")
set(CMAKE_OBJCOPY "${TOOLCHAIN_PREFIX}-objcopy.exe")
set(CMAKE_OBJDUMP "${TOOLCHAIN_PREFIX}-objdump.exe")
set(CMAKE_SIZE "${TOOLCHAIN_PREFIX}-size.exe")
set(CMAKE_RANLIB "${TOOLCHAIN_PREFIX}-ranlib.exe")

set(CMAKE_EXECUTABLE_SUFFIX_C ".elf")
