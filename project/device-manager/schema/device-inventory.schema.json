{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-manager-device-inventory.schema.json",
  "title": "Board Manager Device Inventory",
  "type": "object",
  "required": ["generatedAt", "host", "units"],
  "properties": {
    "generatedAt": { "type": "string" },
    "host": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string" },
        "hostname": { "type": "string" }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unitId", "identity", "transport", "observed", "annotation", "match", "history"],
        "properties": {
          "unitId": { "type": "string" },
          "identity": {
            "type": "object",
            "required": ["stableKey"],
            "properties": {
              "stableKey": { "type": "string" },
              "usbInstance": { "type": ["string", "null"] },
              "mac": { "type": ["string", "null"] },
              "serialNumber": { "type": ["string", "null"] },
              "aliases": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "transport": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "port": { "type": ["string", "null"] },
              "usbInstance": { "type": ["string", "null"] },
              "description": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] }
            }
          },
          "observed": {
            "type": "object",
            "properties": {
              "vid": { "type": ["string", "null"] },
              "pid": { "type": ["string", "null"] },
              "chip": { "type": ["string", "null"] },
              "mac": { "type": ["string", "null"] },
              "serialNumber": { "type": ["string", "null"] },
              "firmwareSignature": { "type": ["string", "null"] },
              "rawSignatureLine": { "type": ["string", "null"] },
              "firmwareLine": { "type": ["string", "null"] },
              "agentLine": { "type": ["string", "null"] },
              "firmwareApp": { "type": ["string", "null"] },
              "firmwareVersion": { "type": ["string", "null"] },
              "firmwareBuildId": { "type": ["string", "null"] },
              "firmwareBoard": { "type": ["string", "null"] },
              "agentCapabilities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "annotation": {
            "type": "object",
            "properties": {
              "label": { "type": ["string", "null"] },
              "notes": { "type": "array", "items": { "type": "string" } },
              "owner": { "type": ["string", "null"] },
              "location": { "type": ["string", "null"] },
              "purpose": { "type": ["string", "null"] },
              "updatedAt": { "type": ["string", "null"] }
            }
          },
          "match": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string" },
              "boardId": { "type": ["string", "null"] },
              "reason": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] }
            }
          },
          "history": {
            "type": "object",
            "required": ["status", "familyKey"],
            "properties": {
              "status": { "type": "string" },
              "familyKey": { "type": "string" },
              "profileId": { "type": ["string", "null"] },
              "firstSeenAt": { "type": ["string", "null"] },
              "lastSeenAt": { "type": ["string", "null"] },
              "seenCount": { "type": ["integer", "null"] },
              "reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
