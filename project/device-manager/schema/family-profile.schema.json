{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-manager-family-profile.schema.json",
  "title": "Board Manager Family Profile",
  "type": "object",
  "required": ["profileId", "familyKey", "status", "createdAt", "fingerprint"],
  "properties": {
    "profileId": { "type": "string" },
    "familyKey": { "type": "string" },
    "status": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "resolvedBoardId": { "type": ["string", "null"] },
    "mergedIntoProfileId": { "type": ["string", "null"] },
    "mergedIntoFamilyKey": { "type": ["string", "null"] },
    "reconciledAt": { "type": ["string", "null"] },
    "boardIds": { "type": "array", "items": { "type": "string" } },
    "sampleUnitIds": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "object" },
    "exactBoard": { "type": ["object", "null"] },
    "candidateBoards": {
      "type": "array",
      "items": { "type": "object" }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "reconciliationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reconciledAt": { "type": "string" },
          "resolvedBoardId": { "type": "string" },
          "mergedIntoProfileId": { "type": "string" },
          "mergedIntoFamilyKey": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "affectedUnitIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
