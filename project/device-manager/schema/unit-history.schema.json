{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-manager-unit-history.schema.json",
  "title": "Board Manager Unit History",
  "type": "object",
  "required": ["generatedAt", "host", "units", "families"],
  "properties": {
    "generatedAt": { "type": "string" },
    "host": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string" },
        "hostname": { "type": "string" }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stableKey", "firstSeenAt", "lastSeenAt", "seenCount", "familyKey", "identity"],
        "properties": {
          "stableKey": { "type": "string" },
          "firstSeenAt": { "type": "string" },
          "lastSeenAt": { "type": "string" },
          "seenCount": { "type": "integer" },
          "familyKey": { "type": "string" },
          "profileId": { "type": ["string", "null"] },
          "boardIds": { "type": "array", "items": { "type": "string" } },
          "identity": { "type": "object" },
          "lastTransport": { "type": "object" },
          "observed": { "type": "object" }
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["familyKey", "firstSeenAt", "lastSeenAt", "seenCount", "status"],
        "properties": {
          "familyKey": { "type": "string" },
          "firstSeenAt": { "type": "string" },
          "lastSeenAt": { "type": "string" },
          "seenCount": { "type": "integer" },
          "status": { "type": "string" },
          "profileId": { "type": ["string", "null"] },
          "boardIds": { "type": "array", "items": { "type": "string" } },
          "sampleUnitIds": { "type": "array", "items": { "type": "string" } },
          "fingerprint": { "type": "object" }
        }
      }
    }
  }
}
