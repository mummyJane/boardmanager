{
  "type": "object",
  "required": ["reportType", "schemaVersion", "generatedAt", "contractId", "identity", "source", "summary", "health", "phases", "checks", "rawCapture"],
  "additionalProperties": false,
  "properties": {
    "reportType": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "contractId": { "type": "string" },
    "identity": {
      "type": "object",
      "required": ["boardId", "boardDisplayName", "stableUnitId", "port", "transportKind", "chip", "macAddress", "serialNumber", "firmwareApp", "firmwareVersion", "firmwareBuildId", "firmwareBoard", "usbVendorId", "usbProductId"],
      "additionalProperties": false,
      "properties": {
        "boardId": { "type": "string" },
        "boardDisplayName": { "type": ["string", "null"] },
        "stableUnitId": { "type": "string" },
        "port": { "type": ["string", "null"] },
        "transportKind": { "type": ["string", "null"] },
        "chip": { "type": ["string", "null"] },
        "macAddress": { "type": ["string", "null"] },
        "serialNumber": { "type": ["string", "null"] },
        "firmwareApp": { "type": ["string", "null"] },
        "firmwareVersion": { "type": ["string", "null"] },
        "firmwareBuildId": { "type": ["string", "null"] },
        "firmwareBoard": { "type": ["string", "null"] },
        "usbVendorId": { "type": ["string", "null"] },
        "usbProductId": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "lineCount"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "lineCount": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overallPass", "executedCheckCount", "failingCheckCount", "warningCount"],
      "additionalProperties": false,
      "properties": {
        "overallPass": { "type": "boolean" },
        "executedCheckCount": { "type": "integer", "minimum": 0 },
        "failingCheckCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 }
      }
    },
    "health": {
      "type": "object",
      "required": ["lineCount", "voltages", "temperatures", "warnings"],
      "additionalProperties": false,
      "properties": {
        "lineCount": { "type": "integer", "minimum": 0 },
        "voltages": { "type": "array", "items": { "type": "object" } },
        "temperatures": { "type": "array", "items": { "type": "object" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phaseId", "order", "level", "target", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "phaseId": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "level": { "type": "string" },
          "target": { "type": ["string", "null"] },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phaseId", "checkId", "level", "target", "kind", "description", "pass", "passCriteria", "evidence", "failureNotes"],
        "additionalProperties": false,
        "properties": {
          "phaseId": { "type": "string" },
          "checkId": { "type": "string" },
          "level": { "type": "string" },
          "target": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "pass": { "type": ["boolean", "null"] },
          "passCriteria": { "type": ["string", "null"] },
          "evidence": { "type": "object" },
          "failureNotes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "rawCapture": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "properties": {
        "lines": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
