{
  "boardId": "m5stack_dial_v1_1",
  "displayName": "M5Stack Dial V1.1",
  "revision": "1.1",
  "vendor": "M5Stack",
  "productSku": "K130",
  "controller": {
    "moduleId": "m5stamps3"
  },
  "capabilities": {
    "usb": true,
    "uart": false,
    "jtag": false,
    "wifi": true,
    "touch": true,
    "display": true,
    "rotaryEncoder": true,
    "rfid": true,
    "rtc": true
  },
  "power": {
    "usbInput": "USB Type-C 5V",
    "terminalInput": "DC 6-36V",
    "batteryInput": "3.7V",
    "holdSignal": "power_hold",
    "wakeButton": "WAKE"
  },
  "signals": [
    {
      "name": "power_hold",
      "kind": "digital_output",
      "logicalFunction": "power_latch",
      "controllerSignal": "GPIO46",
      "peripheral": "POWER_HOLD",
      "activeLevel": "high"
    },
    {
      "name": "lcd_backlight",
      "kind": "digital_output",
      "logicalFunction": "display_backlight",
      "controllerSignal": "GPIO9",
      "peripheral": "GC9A01_BL",
      "activeLevel": "high"
    },
    {
      "name": "buzzer",
      "kind": "digital_output",
      "logicalFunction": "audio_alert",
      "controllerSignal": "GPIO3",
      "peripheral": "BUZZER",
      "activeLevel": "high"
    },
    {
      "name": "rfid_reset",
      "kind": "digital_output",
      "logicalFunction": "rfid_reset",
      "controllerSignal": "GPIO8",
      "peripheral": "WS1850S_RST",
      "activeLevel": "low"
    },
    {
      "name": "touch_interrupt",
      "kind": "digital_input",
      "logicalFunction": "touch_irq",
      "controllerSignal": "GPIO14",
      "peripheral": "FT3267_INT",
      "activeLevel": "low"
    },
    {
      "name": "rfid_interrupt",
      "kind": "digital_input",
      "logicalFunction": "rfid_irq",
      "controllerSignal": "GPIO10",
      "peripheral": "WS1850S_IRQ",
      "activeLevel": "low"
    },
    {
      "name": "encoder_phase_a",
      "kind": "digital_input",
      "logicalFunction": "encoder_phase_a",
      "controllerSignal": "GPIO41",
      "peripheral": "ROTARY_ENCODER_A",
      "activeLevel": "high"
    },
    {
      "name": "encoder_phase_b",
      "kind": "digital_input",
      "logicalFunction": "encoder_phase_b",
      "controllerSignal": "GPIO40",
      "peripheral": "ROTARY_ENCODER_B",
      "activeLevel": "high"
    }
  ],
  "buses": [
    {
      "name": "internal_i2c",
      "kind": "i2c",
      "controllerPeripheral": "I2C0",
      "lines": {
        "sda": "GPIO11",
        "scl": "GPIO12"
      },
      "devices": [
        {
          "instanceId": "rtc",
          "partId": "bm8563",
          "config": {
            "i2cAddress": "0x51"
          }
        },
        {
          "instanceId": "rfid",
          "partId": "ws1850s",
          "config": {
            "i2cAddress": "0x28",
            "interruptSignal": "rfid_interrupt",
            "resetSignal": "rfid_reset"
          }
        },
        {
          "instanceId": "touch",
          "partId": "ft3267",
          "config": {
            "i2cAddress": "0x38",
            "interruptSignal": "touch_interrupt"
          }
        }
      ]
    },
    {
      "name": "display_spi",
      "kind": "spi",
      "controllerPeripheral": "SPI2",
      "lines": {
        "mosi": "GPIO5",
        "sck": "GPIO6",
        "cs": "GPIO7",
        "dc": "GPIO4",
        "reset": "GPIO8",
        "backlight": "GPIO9"
      },
      "devices": [
        {
          "instanceId": "display",
          "partId": "gc9a01",
          "config": {
            "resetSignal": "rfid_reset",
            "backlightSignal": "lcd_backlight"
          }
        }
      ]
    }
  ],
  "bootSequence": [
    { "name": "controller", "kind": "module" },
    { "name": "power_hold", "kind": "signal", "signal": "power_hold", "state": true },
    { "name": "internal_i2c", "kind": "bus", "bus": "internal_i2c" },
    { "name": "rtc", "kind": "device", "instanceId": "rtc" },
    { "name": "touch", "kind": "device", "instanceId": "touch" },
    { "name": "rfid", "kind": "device", "instanceId": "rfid" },
    { "name": "display_spi", "kind": "bus", "bus": "display_spi" },
    { "name": "display", "kind": "device", "instanceId": "display" },
    { "name": "lcd_backlight", "kind": "signal", "signal": "lcd_backlight", "state": true }
  ],
  "connectors": [
    {
      "name": "port_a",
      "type": "HY2.0-4P",
      "pins": [
        { "label": "GND", "signal": "GND" },
        { "label": "5V", "signal": "5V" },
        { "label": "YELLOW", "signal": "GPIO13" },
        { "label": "WHITE", "signal": "GPIO15" }
      ]
    },
    {
      "name": "port_b",
      "type": "HY2.0-4P",
      "pins": [
        { "label": "GND", "signal": "GND" },
        { "label": "5V", "signal": "5V" },
        { "label": "YELLOW", "signal": "GPIO2" },
        { "label": "WHITE", "signal": "GPIO1" }
      ]
    }
  ],
  "sources": [
    "https://docs.m5stack.com/en/core/M5Dial",
    "https://docs.m5stack.com/en/core/M5Dial%20V1.1"
  ]
}
