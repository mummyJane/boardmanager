{
  "projectId": "m5stack_dial_secure_ota",
  "displayName": "M5Stack Dial Secure OTA",
  "boardId": "m5stack_dial_v1_1",
  "app": {
    "appId": "m5stack_dial_secure_ota",
    "appRoot": "apps/m5stack_dial_demo",
    "userCodeRoot": "apps/m5stack_dial_demo/main",
    "generatedSupportRoot": "generated",
    "stableApi": "firmware-common/board_api.h"
  },
  "firmwareTarget": {
    "family": "esp-idf",
    "entryPoint": "main/app_main.c"
  },
  "deployment": {
    "transports": ["usb", "ota"],
    "ota": {
      "supported": true,
      "signing": "per-unit",
      "signedBy": "root",
      "encryption": "per-unit-aes"
    },
    "security": {
      "classification": "secure"
    }
  },
  "partOverrides": {
    "display": {
      "partId": "gc9a01",
      "config": {
        "rotation": 0,
        "backlightDefault": true
      }
    },
    "rtc": {
      "partId": "bm8563",
      "config": {
        "timezone": "UTC"
      }
    },
    "rfid": {
      "partId": "ws1850s",
      "config": {
        "pollIntervalMs": 250
      }
    }
  },
  "signalOverrides": {
    "buzzer": {
      "defaultState": false
    },
    "lcd_backlight": {
      "defaultState": true
    }
  }
}
